19:["$","section",null,{"id":"enso","className":"_merchSection_upxz6_16","aria-labelledby":"merch-heading","children":[["$","div",null,{"className":"_merchIntro_upxz6_17","children":[["$","p",null,{"className":"_kicker_upxz6_669","children":"Ensō Collective"}],["$","h2",null,{"id":"merch-heading","data-motion-reveal":"heading","children":["Give the internet something to ",["$","em",null,{"children":"wear."}]]}]]}],["$","div",null,{"className":"_merchContext_upxz6_19","children":["$","p",null,{"children":"I founded Ensō Collective to connect fashion, technology, and digital identity. I led the brand partnerships, concepts, design, and production behind these digital wearables and physical merch collaborations."}]}],["$","$L1e",null,{"items":[{"src":"/merch/enso-shefi.mp4","poster":"/merch/enso-shefi-poster.jpg","media":"video","alt":"Animated Ensō and SheFi digital merch collaboration","name":"Ensō × SheFi","tone":"butter"},{"src":"/merch/enso-phaver.mp4","poster":"/merch/enso-phaver-poster.jpg","media":"video","alt":"Animated Ensō and Phaver digital hoodie collaboration","name":"Ensō × Phaver","tone":"blue"},{"src":"/merch/jules-sweatshirt.mp4","poster":"/merch/jules-sweatshirt-poster.jpg","media":"video","alt":"Animated Aave and Ensō sweatshirt rotating in a digital landscape","name":"Aave × Ensō","tone":"rose"},{"src":"/merch/mija-enso.jpeg","alt":"Black Mija and Ensō Art Basel shirt with neon green graphics","name":"Mija × Ensō","context":"T-shirt launch in collaboration with Art Basel.","tone":"ivory"},{"src":"/merch/enso-crowdmuse.jpeg","alt":"Blue Ensō and Crowdmuse NFC Lisbon collaboration poster","name":"Ensō × Crowdmuse","tone":"blue"}]}],["$","p",null,{"className":"_merchStory_upxz6_20","children":"I also led a six-person team building Ensō's iOS fashion app, which used AI to recognise brands and clothing and add them to a digital closet. The work brought product development and brand partnerships under one roof."}]]}]
1a:["$","section",null,{"id":"about","className":"_aboutSection_upxz6_22","aria-labelledby":"about-heading","children":[["$","div",null,{"children":["$","h2",null,{"id":"about-heading","data-motion-reveal":"heading","children":"About me."}]}],["$","div",null,{"className":"_aboutCopy_upxz6_24","children":[["$","p",null,{"children":"I lead marketing at Zerion, from our brand and voice to campaigns, partnerships, and events. I lead projects from the first brief through launch and run growth experiments to understand what gets results and why."}],["$","p",null,{"children":"Before Zerion, I worked in fashion and venture capital, then founded a company. My work has included collaborations with Kraken, Revolut, SpaceX, and Privy, as well as partnerships with Coinbase."}],["$","p",null,{"children":"I like turning a good idea into something people want to be part of, then figuring out what made it work."}]]}]]}]
