19:["$","section",null,{"id":"enso","className":"_merchSection_qh8b1_16","aria-labelledby":"merch-heading","children":[["$","div",null,{"className":"_merchIntro_qh8b1_17","children":[["$","p",null,{"className":"_kicker_qh8b1_669","children":"digital identity"}],["$","h2",null,{"id":"merch-heading","data-motion-reveal":"heading","children":["Give the internet something to ",["$","em",null,{"children":"wear."}]]}]]}],["$","div",null,{"className":"_merchContext_qh8b1_19","children":["$","p",null,{"children":"I founded Ensō Collective and led concept, design, partnerships, and production for digital wearables and physical merch."}]}],["$","$L1d",null,{"items":[{"src":"/merch/enso-shefi.mp4","poster":"/merch/enso-shefi-poster.jpg","media":"video","alt":"Animated Ensō and SheFi digital merch collaboration","name":"Ensō × SheFi","tone":"butter"},{"src":"/merch/enso-phaver.mp4","poster":"/merch/enso-phaver-poster.jpg","media":"video","alt":"Animated Ensō and Phaver digital hoodie collaboration","name":"Ensō × Phaver","tone":"blue"},{"src":"/merch/jules-sweatshirt.mp4","poster":"/merch/jules-sweatshirt-poster.jpg","media":"video","alt":"Animated Aave and Ensō sweatshirt rotating in a digital landscape","name":"Aave × Ensō","tone":"rose"},{"src":"/merch/mija-enso.jpeg","alt":"Black Mija and Ensō Art Basel shirt with neon green graphics","name":"Mija × Ensō","context":"T-shirt launch in collaboration with Art Basel.","tone":"ivory"},{"src":"/merch/enso-crowdmuse.jpeg","alt":"Blue Ensō and Crowdmuse NFC Lisbon collaboration poster","name":"Ensō × Crowdmuse","tone":"blue"}]}],["$","p",null,{"className":"_merchStory_qh8b1_20","children":"Alongside the collaborations, I led the six-person team building Ensō's iOS fashion app. It used AI to recognise brands and clothing and add them to a digital closet."}]]}]
1a:["$","section",null,{"id":"about","className":"_aboutSection_qh8b1_22","aria-labelledby":"about-heading","children":[["$","div",null,{"children":["$","h2",null,{"id":"about-heading","data-motion-reveal":"heading","children":"About me."}]}],["$","div",null,{"className":"_aboutCopy_qh8b1_24","children":[["$","p",null,{"children":"Before Zerion, I worked in fashion and venture capital, then founded a company. Fashion shaped my taste and storytelling instincts. VC taught me how companies grow. Founding taught me to execute with limited time, resources, and people."}],["$","p",null,{"children":"I design experiences around how founders build trust and exchange ideas, not standard panels, mixers, or marketing playbooks. My work combines editorial judgment, operational rigor, and AI-native automation, applying human judgment where taste, nuance, and relationships matter."}],["$","p",null,{"children":"In the last year, I produced 36 events that returned more than 2× their spend."}]]}]]}]
