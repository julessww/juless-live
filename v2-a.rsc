19:["$","section",null,{"id":"about","className":"_aboutSection_o01hn_22","aria-labelledby":"about-heading","children":[["$","div",null,{"children":["$","h2",null,{"id":"about-heading","data-motion-reveal":"heading","children":"About me."}]}],["$","div",null,{"className":"_aboutCopy_o01hn_24","children":[["$","p",null,{"children":"Before Zerion, I worked in fashion and venture capital, then founded a company. Fashion shaped my taste and storytelling instincts. VC taught me how companies grow. Founding taught me to execute with limited time, resources, and people."}],["$","p",null,{"children":"I design experiences around how founders build trust and exchange ideas, not standard panels, mixers, or marketing playbooks. My work combines editorial judgment, operational rigor, and AI-native automation, applying human judgment where taste, nuance, and relationships matter."}],["$","p",null,{"children":"In the last year, I produced 36 events that returned more than 2× their spend."}]]}]]}]
